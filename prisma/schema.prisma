generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

enum AppRole {
  USER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum VariantPricingStatus {
  HAS_PRICE
  CONTACT_FOR_PRICE
}

enum QuoteRequestStatus {
  PENDING
  QUOTED
  CANCELLED
  CLOSED
}

enum TaxScope {
  GLOBAL
  CATEGORY
  PRODUCT
  VARIANT
}

enum PaymentProvider {
  VIETQR
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPING
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  WAITING_CUSTOMER_TRANSFER
  CUSTOMER_CONFIRMED
  PAID
  REJECTED
  REFUNDED
}

enum FulfillmentStatus {
  NOT_STARTED
  PROCESSING
  READY_TO_SHIP
  SHIPPING
  DELIVERED
  FAILED
  RETURNED
}

enum PaymentMethod {
  BANK_TRANSFER_QR
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum PromotionDiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum BannerPlacement {
  HOMEPAGE
  PROMOTION
  FLOATING
}

model Category {
  id          String                      @id @default(uuid())
  parentId    String?                     @map("parent_id")
  name        String
  slug        String                      @unique
  description String?
  active      Boolean                     @default(true)
  sortOrder   Int                         @default(0) @map("sort_order")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  parent      Category?                   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]                  @relation("CategoryTree")
  products    Product[]
  variants    ProductVariant[]
  templates   CategoryAttributeTemplate[]

  @@index([parentId], map: "idx_categories_parent_id")
  @@index([active, sortOrder], map: "idx_categories_active_sort_order")
  @@map("categories")
}

model Brand {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  logoUrl      String?          @map("logo_url")
  logoPublicId String?          @map("logo_public_id")
  bannerUrl    String?          @map("banner_url")
  bannerPublicId String?        @map("banner_public_id")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  products     Product[]
  variants     ProductVariant[]

  @@index([active], map: "idx_brands_active")
  @@map("brands")
}

model Product {
  id                String                       @id @default(uuid())
  categoryId        String                       @map("category_id")
  brandId           String?                      @map("brand_id")
  name              String
  slug              String                       @unique
  description       String?
  datasheetUrl      String?                      @map("datasheet_url")
  imageUrls         String[]                     @default([]) @map("image_urls")
  imagePublicIds    String[]                     @default([]) @map("image_public_ids")
  status            ProductStatus                @default(DRAFT)
  active            Boolean                      @default(true)
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  category          Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand             Brand?                       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  attributes        ProductAttributeDefinition[]
  descriptionAssets ProductDescriptionAsset[]
  quoteRequests     QuoteRequest[]

  @@index([categoryId, active], map: "idx_products_category_active")
  @@index([brandId, active], map: "idx_products_brand_active")
  @@map("products")
}

model ProductDescriptionAsset {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  publicId  String   @unique @map("public_id")
  alt       String?
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt], map: "idx_product_description_assets_product_created")
  @@map("product_description_assets")
}

model ProductVariant {
  id                     String                  @id @default(uuid())
  productId              String                  @map("product_id")
  categoryId             String                  @map("category_id")
  brandId                String?                 @map("brand_id")
  sku                    String                  @unique
  manufacturerPartNumber String?                 @map("manufacturer_part_number")
  originCountryCode      String?                 @map("origin_country_code")
  name                   String
  slug                   String                  @unique
  price                  Decimal                 @db.Decimal(12, 2)
  costPrice              Decimal                 @map("cost_price") @db.Decimal(12, 2)
  salePrice              Decimal?                @map("sale_price") @db.Decimal(12, 2)
  discountPercent        Decimal?                @map("discount_percent") @db.Decimal(5, 2)
  pricingStatus          VariantPricingStatus    @default(HAS_PRICE) @map("pricing_status")
  taxPercent             Decimal?                @map("tax_percent") @db.Decimal(5, 2)
  stockQuantity          Int                     @default(0) @map("stock_quantity")
  unit                   String?
  minOrderQuantity       Int                     @default(1) @map("min_order_quantity")
  score                  Decimal                 @default(0) @db.Decimal(12, 4)
  viewCount              Int                     @default(0) @map("view_count")
  orderCount             Int                     @default(0) @map("order_count")
  ratingAverage          Decimal                 @default(5) @map("rating_average") @db.Decimal(3, 2)
  ratingCount            Int                     @default(0) @map("rating_count")
  ratingTotal            Decimal                 @default(0) @map("rating_total") @db.Decimal(12, 2)
  specSnapshot           Json?                   @map("spec_snapshot")
  imageUrls              String[]                @default([]) @map("image_urls")
  imagePublicIds         String[]                @default([]) @map("image_public_ids")
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  category               Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                  Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  attributeValues        VariantAttributeValue[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  quoteRequests          QuoteRequest[]
  promotionItems         PromotionItem[]

  @@index([active, score(sort: Desc)], map: "idx_variants_active_score")
  @@index([categoryId, score(sort: Desc)], map: "idx_variants_category_score")
  @@index([brandId, score(sort: Desc)], map: "idx_variants_brand_score")
  @@index([productId], map: "idx_variants_product_id")
  @@index([originCountryCode], map: "idx_variants_origin_country_code")
  @@index([manufacturerPartNumber], map: "idx_variants_mpn")
  @@map("product_variants")
}

model CategoryAttributeTemplate {
  id                String                       @id @default(uuid())
  categoryId        String                       @map("category_id")
  name              String
  code              String
  dataType          AttributeDataType            @map("data_type")
  unit              String?
  isFilterable      Boolean                      @default(false) @map("is_filterable")
  isSearchable      Boolean                      @default(false) @map("is_searchable")
  isRequired        Boolean                      @default(false) @map("is_required")
  sortOrder         Int                          @default(0) @map("sort_order")
  active            Boolean                      @default(true)
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  category          Category                     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productAttributes ProductAttributeDefinition[]

  @@unique([categoryId, code], map: "uq_category_attribute_templates_category_id_code")
  @@index([categoryId, active, sortOrder], map: "idx_category_attribute_templates_category_active_sort")
  @@map("category_attribute_templates")
}

model ProductAttributeDefinition {
  id                 String                     @id @default(uuid())
  productId          String                     @map("product_id")
  categoryTemplateId String?                    @map("category_template_id")
  name               String
  code               String
  dataType           AttributeDataType          @map("data_type")
  unit               String?
  isFilterable       Boolean                    @default(false) @map("is_filterable")
  isSearchable       Boolean                    @default(false) @map("is_searchable")
  isRequired         Boolean                    @default(false) @map("is_required")
  sortOrder          Int                        @default(0) @map("sort_order")
  active             Boolean                    @default(true)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  product            Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryTemplate   CategoryAttributeTemplate? @relation(fields: [categoryTemplateId], references: [id], onDelete: SetNull)
  values             VariantAttributeValue[]

  @@unique([productId, code], map: "uq_product_attribute_definitions_product_id_code")
  @@index([productId, active, sortOrder], map: "idx_product_attribute_definitions_product_active_sort")
  @@index([code], map: "idx_product_attribute_definitions_code")
  @@map("product_attribute_definitions")
}

model VariantAttributeValue {
  id                           String                     @id @default(uuid())
  variantId                    String                     @map("variant_id")
  productAttributeDefinitionId String                     @map("product_attribute_definition_id")
  valueText                    String?                    @map("value_text")
  valueNumber                  Decimal?                   @map("value_number") @db.Decimal(18, 4)
  valueBoolean                 Boolean?                   @map("value_boolean")
  valueEnum                    String?                    @map("value_enum")
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")
  variant                      ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productAttributeDefinition   ProductAttributeDefinition @relation(fields: [productAttributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([variantId, productAttributeDefinitionId], map: "uq_variant_attribute_values_variant_id_attribute_id")
  @@index([variantId], map: "idx_variant_attribute_values_variant_id")
  @@index([productAttributeDefinitionId, valueText], map: "idx_variant_attribute_values_attr_text")
  @@index([productAttributeDefinitionId, valueNumber], map: "idx_variant_attribute_values_attr_number")
  @@map("variant_attribute_values")
}

model User {
  id               String         @id @default(uuid())
  fullName         String?        @map("full_name")
  dateOfBirth      DateTime?      @map("date_of_birth")
  email            String         @unique
  phoneNumber      String?        @unique @map("phone_number")
  passwordHash     String         @map("password_hash")
  role             AppRole        @default(USER)
  active           Boolean        @default(true)
  refreshTokenHash String?        @map("refresh_token_hash")
  lastLoginAt      DateTime?      @map("last_login_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  addresses        UserAddress[]
  carts            Cart[]
  orders           Order[]        @relation("CustomerOrders")
  verifiedPayments Order[]        @relation("PaymentVerifiedByStaff")
  quoteRequests    QuoteRequest[] @relation("CustomerQuoteRequests")
  claimedQuotes    QuoteRequest[] @relation("QuoteRequestClaimedByStaff")

  @@index([role, active], map: "idx_users_role_active")
  @@map("users")
}

model QuoteRequest {
  id               String             @id @default(uuid())
  requestCode      String             @unique @map("request_code")
  requestGroupCode String             @map("request_group_code")
  userId           String?            @map("user_id")
  productId        String             @map("product_id")
  variantId        String             @map("variant_id")
  customerName     String             @map("customer_name")
  customerEmail    String             @map("customer_email")
  customerPhone    String             @map("customer_phone")
  quantity         Int                @default(1)
  customerNote     String?            @map("customer_note")
  status           QuoteRequestStatus @default(PENDING)
  staffNote        String?            @map("staff_note")
  claimedByStaffId String?            @map("claimed_by_staff_id")
  claimedAt        DateTime?          @map("claimed_at")
  quotedAt         DateTime?          @map("quoted_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  closedAt         DateTime?          @map("closed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  user             User?              @relation("CustomerQuoteRequests", fields: [userId], references: [id], onDelete: SetNull)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  claimedByStaff   User?              @relation("QuoteRequestClaimedByStaff", fields: [claimedByStaffId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_quote_requests_user_created_at")
  @@index([customerEmail, status, createdAt], map: "idx_quote_requests_email_status_created")
  @@index([customerPhone, status, createdAt], map: "idx_quote_requests_phone_status_created")
  @@index([requestGroupCode, createdAt], map: "idx_quote_requests_group_created")
  @@index([status, createdAt], map: "idx_quote_requests_status_created")
  @@index([claimedByStaffId, status], map: "idx_quote_requests_staff_status")
  @@map("quote_requests")
}

model UserAddress {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  label          String
  name           String
  phoneNumber    String?  @map("phone_number")
  provinceCode   String   @map("province_code")
  provinceName   String   @map("province_name")
  wardCode       String   @map("ward_code")
  wardName       String   @map("ward_name")
  streetAddress  String   @map("street_address")
  note           String?
  status         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[]  @relation("OrderShippingAddress")
  invoiceOrders  Order[]  @relation("OrderInvoiceAddress")

  @@index([userId, status], map: "idx_user_addresses_user_id_status")
  @@index([provinceCode, wardCode], map: "idx_user_addresses_province_ward")
  @@map("user_addresses")
}

model Cart {
  id         String     @id @default(uuid())
  userId     String?    @map("user_id")
  guestToken String?    @unique @map("guest_token")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@unique([userId], map: "uq_carts_user_id")
  @@index([userId], map: "idx_carts_user_id")
  @@map("carts")
}

model CartItem {
  id                     String         @id @default(uuid())
  cartId                 String         @map("cart_id")
  productId              String         @map("product_id")
  variantId              String         @map("variant_id")
  quantity               Int
  productNameSnapshot    String         @map("product_name_snapshot")
  variantNameSnapshot    String         @map("variant_name_snapshot")
  priceSnapshot          Decimal        @map("price_snapshot") @db.Decimal(12, 2)
  salePriceSnapshot      Decimal?       @map("sale_price_snapshot") @db.Decimal(12, 2)
  effectivePriceSnapshot Decimal        @map("effective_price_snapshot") @db.Decimal(12, 2)
  imageUrlSnapshot       String?        @map("image_url_snapshot")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  cart                   Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product                Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant                ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId], map: "uq_cart_items_cart_id_variant_id")
  @@index([cartId], map: "idx_cart_items_cart_id")
  @@index([productId], map: "idx_cart_items_product_id")
  @@index([variantId], map: "idx_cart_items_variant_id")
  @@map("cart_items")
}

model Order {
  id                       String            @id @default(uuid())
  orderCode                String            @unique @map("order_code")
  userId                   String?           @map("user_id")
  guestToken               String?           @map("guest_token")
  status                   OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus            PaymentStatus     @default(WAITING_CUSTOMER_TRANSFER) @map("payment_status")
  fulfillmentStatus        FulfillmentStatus @default(NOT_STARTED) @map("fulfillment_status")
  customerName             String?           @map("customer_name")
  customerEmail            String?           @map("customer_email")
  customerPhone            String?           @map("customer_phone")
  shippingAddressId        String?           @map("shipping_address_id")
  shippingName             String            @map("shipping_name")
  shippingPhone            String?           @map("shipping_phone")
  shippingProvinceCode     String            @map("shipping_province_code")
  shippingProvinceName     String            @map("shipping_province_name")
  shippingWardCode         String            @map("shipping_ward_code")
  shippingWardName         String            @map("shipping_ward_name")
  shippingStreetAddress    String            @map("shipping_street_address")
  shippingNote             String?           @map("shipping_note")
  invoiceRequested         Boolean           @default(false) @map("invoice_requested")
  invoiceAddressId         String?           @map("invoice_address_id")
  invoiceName              String?           @map("invoice_name")
  invoicePhone             String?           @map("invoice_phone")
  invoiceCompanyName       String?           @map("invoice_company_name")
  invoiceTaxCode           String?           @map("invoice_tax_code")
  invoiceEmail             String?           @map("invoice_email")
  invoiceProvinceCode      String?           @map("invoice_province_code")
  invoiceProvinceName      String?           @map("invoice_province_name")
  invoiceWardCode          String?           @map("invoice_ward_code")
  invoiceWardName          String?           @map("invoice_ward_name")
  invoiceStreetAddress     String?           @map("invoice_street_address")
  voucherCode              String?           @map("voucher_code")
  subtotalAmount           Decimal           @map("subtotal_amount") @db.Decimal(12, 2)
  taxAmount                Decimal           @map("tax_amount") @db.Decimal(12, 2)
  shippingFee              Decimal           @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount           Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  grandTotalAmount         Decimal           @map("grand_total_amount") @db.Decimal(12, 2)
  paymentMethod            PaymentMethod     @default(BANK_TRANSFER_QR) @map("payment_method")
  paymentProvider          PaymentProvider?  @map("payment_provider")
  paymentQrUrl             String?           @map("payment_qr_url")
  paymentBankCode          String?           @map("payment_bank_code")
  paymentBankName          String?           @map("payment_bank_name")
  paymentBankAccountNumber String?           @map("payment_bank_account_number")
  paymentBankAccountName   String?           @map("payment_bank_account_name")
  paymentTransferContent   String?           @map("payment_transfer_content")
  paymentConfirmedByUserAt DateTime?         @map("payment_confirmed_by_user_at")
  paymentVerifiedAt        DateTime?         @map("payment_verified_at")
  paymentVerifiedByStaffId String?           @map("payment_verified_by_staff_id")
  paymentRejectReason      String?           @map("payment_reject_reason")
  customerNote             String?           @map("customer_note")
  staffNote                String?           @map("staff_note")
  cancelledAt              DateTime?         @map("cancelled_at")
  completedAt              DateTime?         @map("completed_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  user                     User?             @relation("CustomerOrders", fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress          UserAddress?      @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  invoiceAddress           UserAddress?      @relation("OrderInvoiceAddress", fields: [invoiceAddressId], references: [id], onDelete: SetNull)
  paymentVerifiedByStaff   User?             @relation("PaymentVerifiedByStaff", fields: [paymentVerifiedByStaffId], references: [id], onDelete: SetNull)
  items                    OrderItem[]

  @@index([userId, createdAt], map: "idx_orders_user_created_at")
  @@index([guestToken, createdAt], map: "idx_orders_guest_token_created_at")
  @@index([orderCode, customerEmail], map: "idx_orders_order_code_customer_email")
  @@index([status, createdAt], map: "idx_orders_status_created_at")
  @@index([paymentStatus, createdAt], map: "idx_orders_payment_status_created_at")
  @@map("orders")
}

model OrderItem {
  id                     String         @id @default(uuid())
  orderId                String         @map("order_id")
  productId              String         @map("product_id")
  variantId              String         @map("variant_id")
  productNameSnapshot    String         @map("product_name_snapshot")
  variantNameSnapshot    String         @map("variant_name_snapshot")
  skuSnapshot            String         @map("sku_snapshot")
  imageUrlSnapshot       String?        @map("image_url_snapshot")
  unitSnapshot           String?        @map("unit_snapshot")
  quantity               Int
  priceSnapshot          Decimal        @map("price_snapshot") @db.Decimal(12, 2)
  salePriceSnapshot      Decimal?       @map("sale_price_snapshot") @db.Decimal(12, 2)
  effectivePriceSnapshot Decimal        @map("effective_price_snapshot") @db.Decimal(12, 2)
  taxPercentSnapshot     Decimal        @map("tax_percent_snapshot") @db.Decimal(5, 2)
  taxAmount              Decimal        @map("tax_amount") @db.Decimal(12, 2)
  subtotalAmount         Decimal        @map("subtotal_amount") @db.Decimal(12, 2)
  totalAmount            Decimal        @map("total_amount") @db.Decimal(12, 2)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  order                  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant                ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@index([variantId], map: "idx_order_items_variant_id")
  @@map("order_items")
}

model TaxSetting {
  id         String   @id @default(uuid())
  scope      TaxScope
  targetId   String?  @map("target_id")
  targetKey  String   @map("target_key")
  taxPercent Decimal  @map("tax_percent") @db.Decimal(5, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([scope, targetKey], map: "uq_tax_settings_scope_target_key")
  @@index([scope], map: "idx_tax_settings_scope")
  @@map("tax_settings")
}

model PaymentSetting {
  id                      String          @id @default(uuid())
  provider                PaymentProvider @default(VIETQR)
  bankCode                String          @map("bank_code")
  bankName                String          @map("bank_name")
  accountNumber           String          @map("account_number")
  accountName             String          @map("account_name")
  qrTemplate              String          @default("compact2") @map("qr_template")
  transferContentTemplate String          @default("AHSO {orderCode}") @map("transfer_content_template")
  active                  Boolean         @default(false)
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  @@index([active], map: "idx_payment_settings_active")
  @@map("payment_settings")
}

model Promotion {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  description          String?
  bannerImageUrl       String?               @map("banner_image_url")
  bannerImagePublicId  String?               @map("banner_image_public_id")
  bannerLinkUrl        String?               @map("banner_link_url")
  defaultDiscountType  PromotionDiscountType @default(PERCENT) @map("default_discount_type")
  defaultDiscountValue Decimal               @map("default_discount_value") @db.Decimal(12, 2)
  status               PromotionStatus       @default(DRAFT)
  startsAt             DateTime              @map("starts_at")
  endsAt               DateTime?             @map("ends_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  items                PromotionItem[]

  @@index([status, startsAt, endsAt], map: "idx_promotions_status_schedule")
  @@map("promotions")
}

model PromotionItem {
  id            String                 @id @default(uuid())
  promotionId   String                 @map("promotion_id")
  variantId     String                 @map("variant_id")
  discountType  PromotionDiscountType? @map("discount_type")
  discountValue Decimal?               @map("discount_value") @db.Decimal(12, 2)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  promotion     Promotion              @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variant       ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([promotionId, variantId], map: "uq_promotion_items_promotion_variant")
  @@index([variantId], map: "idx_promotion_items_variant_id")
  @@map("promotion_items")
}

model MarketingBanner {
  id            String          @id @default(uuid())
  placement     BannerPlacement
  imageUrl      String?         @map("image_url")
  imagePublicId String?         @map("image_public_id")
  linkUrl       String?         @map("link_url")
  active        Boolean         @default(true)
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([placement, active, sortOrder], map: "idx_marketing_banners_placement_active_sort")
  @@map("marketing_banners")
}

model MailSetting {
  id                         String   @id @default(uuid())
  adminOrderRecipients       String[] @default([]) @map("admin_order_recipients")
  notifyRegistrationCustomer Boolean  @default(true) @map("notify_registration_customer")
  notifyOrderCreatedCustomer Boolean  @default(true) @map("notify_order_created_customer")
  notifyOrderStatusCustomer  Boolean  @default(true) @map("notify_order_status_customer")
  notifyOrderCreatedAdmin    Boolean  @default(true) @map("notify_order_created_admin")
  notifyOrderCompletedAdmin  Boolean  @default(true) @map("notify_order_completed_admin")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("mail_settings")
}
